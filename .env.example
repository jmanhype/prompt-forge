# Prompt Forge Configuration
# Copy to .env and edit

# ComfyUI connection (REQUIRED)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ROOT=/home/straughter/ComfyUI

# Florence-2 model (default: base for low VRAM)
FLORENCE_MODEL=microsoft/Florence-2-base-ft
# Options: microsoft/Florence-2-base-ft (230MB, CPU OK)
#          microsoft/Florence-2-large-ft (770MB, ~4GB VRAM)

# Optional: Qwen-VL for advanced style extraction
# QWEN_VL_ENABLED=false
# QWEN_VL_URL=http://127.0.0.1:8080/v1
# QWEN_VL_MODEL=qwen-vl-max

# Forge settings
MAX_ITERATIONS=5
CONVERGENCE_THRESHOLD=0.85
FORGE_PORT=7861

# Data directory (relative to project root)
DATA_DIR=./data
